# Copie este arquivo para .env e ajuste os valores. Nunca envie o .env para o GitHub.

# Versão do modelo em uso (pasta dentro de modelos/)
MODELO_ATIVO=v1

# Limiar de confiança. Deixe vazio para usar o valor calibrado pelo treino/avaliar.py
LIMIAR=

# Chave da API do Gemini (https://aistudio.google.com/apikey).
# Deixe vazio para rodar só com o modelo próprio.
GEMINI_API_KEY=
MODELO_GEMINI=gemini-3.5-flash-lite
TIMEOUT_GEMINI_S=15

# Fotos guardadas para revisão: duvidosas (padrão), todas ou nenhuma
SALVAR_IMAGENS=duvidosas

# Limites de uso
MAX_MB=10
LIMITE_POR_MINUTO=30
